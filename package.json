    "@prisma/client": "7.9.1",
    "@upstash/redis": "^1.35.3",
    "argon2": "^0.44.0",
    "jose": "^6.1.0",
    "next": "16.2.12",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "redis": "^5.8.2",
    "resend": "^6.0.2",
