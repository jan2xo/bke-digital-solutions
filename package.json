{
  "name": "bke-digital-solutions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "certification:vitest": "vitest run --exclude tests/minio-bootstrap.test.ts",
    "certification:minio": "vitest run tests/minio-bootstrap.test.ts",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate && node scripts/normalize-generated.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:smoke": "tsx scripts/post-migration-smoke.ts",
    "db:seed": "tsx prisma/seed.ts",
    "agent:demo:seed": "NODE_OPTIONS=--conditions=react-server tsx scripts/seed-agent-demo.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "admin:recover-mfa": "tsx scripts/recover-admin.ts",
    "grace:status": "tsx scripts/grace-period.ts status",
    "grace:set": "tsx scripts/grace-period.ts set",
    "payments:reconcile": "tsx scripts/reconcile-payments.ts",
    "test:paymongo": "vitest run tests/sandbox/paymongo.sandbox.test.ts",
    "test:resend": "vitest run tests/sandbox/resend.sandbox.test.ts",
    "certification:test:paymongo": "node --env-file=.env.certification ./node_modules/vitest/vitest.mjs run tests/sandbox/paymongo.sandbox.test.ts",
    "certification:test:resend": "node --env-file=.env.certification ./node_modules/vitest/vitest.mjs run tests/sandbox/resend.sandbox.test.ts",
    "certification:check": "node --env-file=.env.certification ./node_modules/tsx/dist/cli.mjs scripts/validate-environment.ts",
    "certification:outbox": "node --env-file=.env.certification ./node_modules/tsx/dist/cli.mjs scripts/process-email-outbox.ts",
    "certification:queue-email": "tsx scripts/queue-certification-email.ts",
    "config:validate": "tsx scripts/validate-environment.ts",
    "certification:env": "tsx scripts/create-certification-env.ts",
    "certification:compose": "node scripts/certification-compose.mjs",
    "licensing:keys": "node scripts/generate-license-signing-keys.mjs",
    "certification:test:all": "node scripts/certification-host-command.mjs npm run certification:vitest",
    "certification:test:e2e": "node scripts/certification-e2e.mjs",
    "certification:db:status": "node scripts/certification-host-command.mjs npx prisma migrate status",
    "certification:db:smoke": "node scripts/certification-host-command.mjs npm run db:smoke",
    "health:check": "tsx scripts/health-check.ts",
    "scheduler:run": "tsx scripts/run-scheduler.ts",
    "backups:worker": "NODE_OPTIONS=--conditions=react-server tsx scripts/backup-worker.ts",
    "backups:create": "NODE_OPTIONS=--conditions=react-server tsx scripts/request-backup.ts",
    "backups:certify-local": "NODE_OPTIONS=--conditions=react-server tsx scripts/certify-backup-local.ts",
    "supplychain:backup-evidence": "NODE_OPTIONS=--conditions=react-server tsx scripts/export-backup-evidence.ts",
    "security:hygiene": "node scripts/repository-hygiene.mjs",
    "security:audit-host": "bash scripts/audit-host-security.sh",
    "supplychain:sbom": "node scripts/generate-sbom.mjs",
    "supplychain:provenance": "node scripts/generate-provenance.mjs",
    "supplychain:evidence": "node scripts/generate-release-evidence.mjs",
    "supplychain:generate": "node scripts/generate-supply-chain-evidence.mjs",
    "supplychain:dependencies": "node scripts/generate-dependency-evidence.mjs",
    "ops:validate": "node scripts/ops-validate-production.mjs",
    "ops:health": "node scripts/ops-health.mjs",
    "deployment:verify-restart": "node scripts/verify-compose-restart-policies.mjs",
    "deployment:verify-manifest": "node scripts/verify-deployment-manifest.mjs",
    "deployment:verify-routes": "node scripts/verify-production-routes.mjs",
    "deploy": "bash scripts/deploy-production.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.883.0",
    "@aws-sdk/s3-request-presigner": "^3.883.0",
    "@bke/accounts": "https://github.com/jan2xo/bke-libraries-typescript/releases/download/accounts-v0.1.0/bke-accounts-0.1.0.tgz",
    "@bke/catalog": "https://github.com/jan2xo/bke-libraries-typescript/releases/download/catalog-v0.1.0/bke-catalog-0.1.0.tgz",
    "@bke/commerce": "https://github.com/jan2xo/bke-libraries-typescript/releases/download/commerce-v0.2.0/bke-commerce-0.2.0.tgz",
    "@bke/entitlements": "https://github.com/jan2xo/bke-libraries-typescript/releases/download/entitlements-v0.1.0/bke-entitlements-0.1.0.tgz",
    "@bke/identity": "https://github.com/jan2xo/bke-libraries-typescript/releases/download/identity-v0.2.0/bke-identity-0.2.0.tgz",
    "@bke/legal": "https://github.com/jan2xo/bke-libraries-typescript/releases/download/legal-v0.3.0/bke-legal-0.3.0.tgz",
    "@bke/licensing": "https://github.com/jan2xo/bke-libraries-typescript/releases/download/licensing-v0.1.0/bke-licensing-0.1.0.tgz",
    "@bke/notifications": "https://github.com/jan2xo/bke-libraries-typescript/releases/download/notifications-v0.1.0/bke-notifications-0.1.0.tgz",
    "@bke/payments": "https://github.com/jan2xo/bke-libraries-typescript/releases/download/payments-v0.1.0/bke-payments-0.1.0.tgz",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@upstash/redis": "^1.35.3",
    "argon2": "^0.44.0",
    "jose": "^6.1.0",
    "next": "16.2.12",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "redis": "^5.8.2",
    "resend": "^6.0.2",
    "semver": "^7.8.5",
    "server-only": "^0.0.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/semver": "^7.8.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "prisma": "7.9.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "fast-uri": "3.1.5",
    "find-my-way": "9.7.0",
    "postcss": "8.5.25",
    "nanoid": "3.3.18",
    "sharp": "0.35.3",
    "valibot": "1.4.2"
  }
}
