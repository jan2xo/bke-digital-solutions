generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GlobalRole {
  CUSTOMER
  ADMIN
}

enum AccountType {
  INDIVIDUAL
  ORGANIZATION
}

enum MemberRole {
  OWNER
  BILLING
  LICENSE_MANAGER
  MEMBER
}

enum CustomerLifecycleState {
  ACTIVE
  SUSPENDED
  CLOSURE_REQUESTED
  CLOSED
  PRIVACY_REVIEW
  PSEUDONYMIZED
  PURGE_ELIGIBLE
}

enum StorageCleanupStatus {
  PENDING
  PROCESSING
  RETRYING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum ArtifactUploadState {
  PENDING
  UPLOADED
  VERIFYING
  VERIFIED
  FAILED
  EXPIRED
}

enum CommissioningStatus {
  PENDING
  VERIFYING
  ANALYZING
  EVIDENCE_READY
  FAILED
  SUPERSEDED
}

enum ScheduledJobRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  RETRYING
  ABANDONED
  CANCELLED
  SKIPPED
}

enum ScheduledJobTrigger {
  SCHEDULED
  RETRY
  MANUAL
  CRON
  CLI
  CERTIFICATION
}

enum BackupArchiveStatus {
  PENDING
  CREATING
  AVAILABLE
  VERIFIED
  INCOMPLETE
  CORRUPT
  FAILED
  EXPIRED
  DELETED
}

enum BackupRetentionTier {
  MANUAL
  DAILY
  WEEKLY
  MONTHLY
}

enum BackupOperationType {
  CREATE
  VERIFY
  SIMULATE_RESTORE
  RESTORE_ISOLATED
  DELETE_EXPIRED
}

enum BackupOperationStatus {
  PENDING
  PROCESSING
  RETRYING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum BackupOperationTrigger {
  SCHEDULED
  MANUAL
  CLI
}

enum ObservabilityAlertSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum ObservabilityAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum StorageCleanupJobType {
  PRODUCT_DELETION
  ARTIFACT_REPLACEMENT
  ARTIFACT_REMOVAL
  ABANDONED_UPLOAD
  ORPHANED_OBJECT
}

enum ProductType {
  SOFTWARE
  SAAS
  HYBRID
}

enum ReleaseChannel {
  STABLE
  BETA
}

enum ReleaseLifecycle {
  DRAFT
  INTERNAL
  ALPHA
  BETA
  RELEASE_CANDIDATE
  STABLE
  LTS
  DEPRECATED
  ARCHIVED
}

enum BillingType {
  ONE_TIME
  SUBSCRIPTION
}

enum IntervalUnit {
  MONTH
  YEAR
}

enum PurchasePlanType {
  PERPETUAL
  MONTHLY
  ANNUAL
}

enum RenewalBehavior {
  NONE
  CUSTOMER_AUTHORIZED
}

enum UpdatePolicy {
  LIFETIME
  ACTIVE_TERM
  MAJOR_VERSION
}

enum TrialSource {
  SELF_SERVICE
  ADMIN
}

enum DiscountType {
  GENERAL_PROMOTION
  CUSTOMER_ACCOUNT_OFFER
  ADMINISTRATIVE_ADJUSTMENT
}

enum DiscountStatus {
  DRAFT
  ACTIVE
  DISABLED
  REVOKED
  EXPIRED
}

enum OfferRedemptionStatus {
  RESERVED
  APPLIED
  RELEASED
  REFUNDED
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum InvoiceStatus {
  DRAFT
  FINAL
  VOID
}

enum LicenseStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
  REVOKED
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  EXPIRED
  CANCELLED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum MfaChallengePurpose {
  LOGIN
  ENROLLMENT
  RECENT_AUTH
}

enum SecurityEventType {
  ADMIN_LOGIN_SUCCEEDED
  ADMIN_LOGIN_FAILED
  ADMIN_PASSWORD_ACCEPTED
  ADMIN_PASSWORD_REJECTED
  ADMIN_SESSION_CREATED
  MFA_CHALLENGE_SUCCEEDED
  MFA_CHALLENGE_FAILED
  MFA_ENROLLED
  MFA_DISABLED
  MFA_RECOVERY_USED
  MFA_RECOVERY_REGENERATED
  RECENT_AUTH_SUCCEEDED
  RECENT_AUTH_FAILED
  ADMIN_SESSION_REVOKED
  ADMIN_MAGIC_LOGIN_BLOCKED
  MFA_ENROLLMENT_STARTED
  PASSWORD_CHANGED
  PASSWORD_RESET_COMPLETED
  ADMIN_ALL_OTHER_SESSIONS_REVOKED
  ADMIN_ALL_SESSIONS_REVOKED
  SECURITY_RATE_LIMIT_TRIGGERED
  PROVIDER_CREDENTIAL_REPLACED
  PROVIDER_CREDENTIAL_REVOKED
  PROVIDER_VALIDATION_SUCCEEDED
  PROVIDER_VALIDATION_FAILED
  LIVE_PAYMENT_ENABLE_BLOCKED
  CUSTOMER_LIFECYCLE_CHANGED
  CUSTOMER_PURGE_EXECUTED
  STORAGE_CLEANUP_FAILED
}

enum SecurityEventOutcome {
  SUCCESS
  FAILURE
  BLOCKED
  INFORMATIONAL
}

enum SecurityEventSeverity {
  INFORMATIONAL
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SessionAuthenticationMethod {
  PASSWORD
  PASSWORD_TOTP
  PASSWORD_EMAIL_OTP
  PASSWORD_RECOVERY
  MAGIC_LINK
  MFA_ENROLLMENT
}

enum SessionAssuranceLevel {
  BASIC
  MFA_VERIFIED
  RECENTLY_AUTHENTICATED
}

enum ExternalProvider {
  PAYMONGO
  RESEND
}

enum ProviderEnvironment {
  TEST
  LIVE
}

enum ProviderCredentialType {
  SECRET_KEY
  WEBHOOK_SECRET
  API_KEY
}

enum ProviderValidationStatus {
  NOT_VALIDATED
  VALID
  INVALID
}

enum SupportTicketCategory {
  ACCOUNT
  PAYMENT
  REFUND
  INVOICE
  LICENSE
  DEVICE
  DOWNLOAD
  SECURITY
  FEATURE_REQUEST
  OTHER
}

enum SupportTicketState {
  OPEN
  TRIAGED
  WAITING_ON_CUSTOMER
  WAITING_ON_SUPPORT
  ESCALATED
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SupportMessageVisibility {
  PUBLIC
  INTERNAL
}

model User {
  id                              String                          @id @default(cuid())
  email                           String                          @unique
  name                            String?
  emailVerified                   DateTime?
  role                            GlobalRole                      @default(CUSTOMER)
  createdAt                       DateTime                        @default(now())
  updatedAt                       DateTime                        @updatedAt
  suspendedAt                     DateTime?
  lifecycleState                  CustomerLifecycleState          @default(ACTIVE)
  privacyRequestedAt              DateTime?
  pseudonymizedAt                 DateTime?
  retentionExpiresAt              DateTime?
  legalHoldAt                     DateTime?
  legalHoldReason                 String?
  emailHash                       String?
  credential                      PasswordCredential?
  sessions                        Session[]
  ownedAccounts                   CustomerAccount[]               @relation("AccountOwner")
  memberships                     Membership[]
  assignments                     LicenseAssignment[]
  auditLogs                       AuditLog[]                      @relation("AuditActor")
  siteContentEdits                SiteContent[]                   @relation("SiteContentEditor")
  createdOffers                   DiscountOffer[]                 @relation("OfferCreator")
  administratorMfa                AdministratorMfaMethod?
  recoveryCodes                   AdministratorRecoveryCode[]
  mfaChallenges                   MfaChallenge[]
  emergencyMfaAuthorizations     EmergencyMfaEnrollmentAuthorization[]
  securityEvents                  SecurityEvent[]
  artifactUploadSessions          ArtifactUploadSession[]          @relation("ArtifactUploadCreator")
  providerConfigurationsCreated   ExternalProviderConfiguration[] @relation("ProviderConfigurationCreator")
  providerConfigurationsUpdated   ExternalProviderConfiguration[] @relation("ProviderConfigurationUpdater")
  providerCredentialsCreated      ExternalProviderCredential[]    @relation("ProviderCredentialCreator")
  legalVersionsAuthored           LegalDocumentVersion[]          @relation("LegalVersionAuthor")
  legalAcceptances                LegalAcceptance[]
  storageCleanupJobsCreated       StorageCleanupJob[]             @relation("StorageCleanupCreator")
  refundOperationsRequested       RefundOperation[]               @relation("RefundRequester")
  reconciliationsRun              PaymentReconciliation[]         @relation("ReconciliationRunner")
  reconciliationsAcknowledged     PaymentReconciliation[]         @relation("ReconciliationAcknowledger")
  webhookEventsAcknowledged       WebhookEvent[]                  @relation("WebhookAcknowledger")
  scheduledRunsAcknowledged       ScheduledJobRun[]
  backupOperationsRequested       BackupOperation[]               @relation("BackupOperationRequester")
  observabilityAlertsAcknowledged ObservabilityAlert[]            @relation("ObservabilityAlertAcknowledger")
  observabilityAlertsResolved     ObservabilityAlert[]            @relation("ObservabilityAlertResolver")
  complianceEvidenceRecorded      ComplianceEvidence[]
  privacyRequests                 PrivacyRequest[]            @relation("PrivacyRequestUser")
  privacyRequestsReviewed         PrivacyRequest[]            @relation("PrivacyRequestReviewer")
  privacyRequestEvents            PrivacyRequestEvent[]       @relation("PrivacyRequestEventActor")
  releaseApprovalsCreated         ReleaseApproval[] @relation("ReleaseApprovalCreator")
  releaseApprovalsReviewed        ReleaseApproval[] @relation("ReleaseApprovalReviewer")
  releaseApprovalsApproved        ReleaseApproval[] @relation("ReleaseApprovalApprover")
  supportTicketsCreated           SupportTicket[]   @relation("SupportTicketCreator")
  supportTicketsAssigned          SupportTicket[]   @relation("SupportTicketAssignee")
  supportMessages                 SupportTicketMessage[] @relation("SupportMessageAuthor")
  supportEvents                   SupportTicketEvent[] @relation("SupportEventActor")

  @@index([lifecycleState])
  @@index([retentionExpiresAt])
  @@index([legalHoldAt])
}

model PasswordCredential {
  userId       String   @id
  passwordHash String
  changedAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id                    String                      @id @default(cuid())
  tokenHash             String                      @unique
  userId                String
  expiresAt             DateTime
  lastAuthenticatedAt   DateTime                    @default(now())
  mfaVerifiedAt         DateTime?
  recentAuthenticatedAt DateTime?
  lastSeenAt            DateTime                    @default(now())
  absoluteExpiresAt     DateTime
  ipHash                String?
  userAgent             String?
  userAgentSummary      String?
  networkHint           String?
  authenticationMethod  SessionAuthenticationMethod @default(PASSWORD)
  assuranceLevel        SessionAssuranceLevel       @default(BASIC)
  revokedAt             DateTime?
  revocationReason      String?
  createdAt             DateTime                    @default(now())
  user                  User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  securityEvents        SecurityEvent[]

  @@index([userId, expiresAt])
  @@index([userId, revokedAt])
  @@index([userId, absoluteExpiresAt])
  @@index([userId, lastSeenAt])
}

model AdministratorMfaMethod {
  id               String    @id @default(cuid())
  userId           String    @unique
  encryptedSecret  String?
  keyVersion       Int       @default(1)
  pendingExpiresAt DateTime?
  enabledAt        DateTime?
  verifiedAt       DateTime?
  disabledAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdministratorRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}

model MfaChallenge {
  id           String              @id @default(cuid())
  userId       String
  purpose      MfaChallengePurpose @default(LOGIN)
  tokenHash    String              @unique
  codeHash     String?
  expiresAt    DateTime
  consumedAt   DateTime?
  attemptCount Int                 @default(0)
  createdAt    DateTime            @default(now())
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model EmergencyMfaEnrollmentAuthorization {
  id                 String    @id @default(cuid())
  userId             String
  tokenHash          String    @unique
  createdAt          DateTime  @default(now())
  expiresAt          DateTime
  consumedAt         DateTime?
  revokedAt          DateTime?
  recoveryReason     String
  operatorIdentity   String
  ownerKeyVersion    Int
  deploymentEnvironment String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt, consumedAt])
}

model SecurityEvent {
  id                   String                       @id @default(cuid())
  userId               String?
  type                 SecurityEventType
  outcome              SecurityEventOutcome         @default(INFORMATIONAL)
  severity             SecurityEventSeverity        @default(INFORMATIONAL)
  sessionId            String?
  provider             ExternalProvider?
  authenticationMethod SessionAuthenticationMethod?
  ipHint               String?
  userAgentHint        String?
  metadata             Json?
  createdAt            DateTime                     @default(now())
  user                 User?                        @relation(fields: [userId], references: [id], onDelete: SetNull)
  session              Session?                     @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([severity, createdAt])
  @@index([outcome, createdAt])
  @@index([provider, createdAt])
}

model VerificationToken {
  id         String    @id @default(cuid())
  identifier String
  purpose    String
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([identifier, purpose])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model CustomerAccount {
  id                 String                 @id @default(cuid())
  type               AccountType
  displayName        String
  ownerId            String
  billingEmail       String
  taxId              String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  lifecycleState     CustomerLifecycleState @default(ACTIVE)
  closureRequestedAt DateTime?
  closedAt           DateTime?
  privacyRequestedAt DateTime?
  pseudonymizedAt    DateTime?
  retentionExpiresAt DateTime?
  legalHoldAt        DateTime?
  legalHoldReason    String?
  owner              User                   @relation("AccountOwner", fields: [ownerId], references: [id])
  organization       OrganizationProfile?
  memberships        Membership[]
  invitations        Invitation[]
  carts              Cart[]
  orders             Order[]
  licenses           License[]
  subscriptions      Subscription[]
  auditLogs          AuditLog[]
  trials             TrialGrant[]
  offers             DiscountOffer[]
  offerRedemptions   OfferRedemption[]
  legalAcceptances   LegalAcceptance[]
  privacyRequests    PrivacyRequest[]
  supportTickets     SupportTicket[]

  @@index([ownerId])
  @@index([lifecycleState])
  @@index([closedAt])
  @@index([retentionExpiresAt])
  @@index([legalHoldAt])
}

model LegalDocument {
  id                        String                 @id @default(cuid())
  title                     String
  slug                      String                 @unique
  documentType              String                 @unique
  status                    String                 @default("ACTIVE")
  currentPublishedVersionId String?                @unique
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt
  versions                  LegalDocumentVersion[] @relation("LegalDocumentVersions")
  currentPublishedVersion   LegalDocumentVersion?  @relation("CurrentPublishedLegalVersion", fields: [currentPublishedVersionId], references: [id], onDelete: SetNull)

  @@index([documentType, status])
}

model LegalDocumentVersion {
  id                        String                 @id @default(cuid())
  legalDocumentId           String
  version                   String
  title                     String
  contentMarkdown           String
  contentSha256             String
  publishedAt               DateTime?
  retiredAt                 DateTime?
  effectiveAt               DateTime?
  createdAt                 DateTime               @default(now())
  createdById               String
  legalDocument             LegalDocument          @relation("LegalDocumentVersions", fields: [legalDocumentId], references: [id], onDelete: Cascade)
  createdBy                 User                   @relation("LegalVersionAuthor", fields: [createdById], references: [id])
  currentForDocument        LegalDocument?         @relation("CurrentPublishedLegalVersion")
  acceptances               LegalAcceptance[]

  @@unique([legalDocumentId, version])
  @@index([legalDocumentId, publishedAt])
}

model LegalAcceptance {
  id                     String               @id @default(cuid())
  userId                 String
  accountId              String?
  legalDocumentVersionId String
  acceptedAt             DateTime             @default(now())
  ipHash                 String?
  userAgentHash          String?
  acceptanceContext      String
  user                   User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  account                CustomerAccount?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  legalDocumentVersion   LegalDocumentVersion @relation(fields: [legalDocumentVersionId], references: [id], onDelete: Restrict)

  @@unique([userId, legalDocumentVersionId, acceptanceContext])
  @@index([accountId, acceptedAt])
}

model PrivacyRequest {
  id                 String                 @id @default(cuid())
  userId             String
  accountId          String?
  type               String
  status             String                 @default("OPEN")
  requestedAt        DateTime               @default(now())
  dueAt              DateTime
  completedAt        DateTime?
  cancelledAt        DateTime?
  requestReason      String?
  outcomeSummary     String?
  reviewedById       String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  user               User                   @relation("PrivacyRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  account            CustomerAccount?       @relation(fields: [accountId], references: [id], onDelete: SetNull)
  reviewedBy         User?                  @relation("PrivacyRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  events             PrivacyRequestEvent[]

  @@index([userId, status, requestedAt])
  @@index([accountId, status, requestedAt])
  @@index([dueAt, status])
}

model PrivacyRequestEvent {
  id               String         @id @default(cuid())
  privacyRequestId String
  actorId          String?
  action           String
  metadata         Json?
  createdAt        DateTime       @default(now())
  privacyRequest   PrivacyRequest @relation(fields: [privacyRequestId], references: [id], onDelete: Cascade)
  actor            User?          @relation("PrivacyRequestEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([privacyRequestId, createdAt])
  @@index([actorId, createdAt])
}

model OrganizationProfile {
  accountId          String          @id
  legalName          String
  registrationNumber String?
  account            CustomerAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model Membership {
  accountId String
  userId    String
  role      MemberRole
  createdAt DateTime        @default(now())
  account   CustomerAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([accountId, userId])
  @@index([userId])
}

model Invitation {
  id        String           @id @default(cuid())
  accountId String
  email     String
  role      MemberRole
  tokenHash String           @unique
  status    InvitationStatus @default(PENDING)
  expiresAt DateTime
  createdAt DateTime         @default(now())
  account   CustomerAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, email])
}

model Product {
  id                  String              @id @default(cuid())
  slug                String              @unique
  productId           String?             @unique
  minimumAcceptedVersion String?
  maximumAcceptedVersion String?
  name                String
  summary             String
  description         String
  type                ProductType
  category            String              @default("General")
  licenseType         String              @default("Commercial")
  featured            Boolean             @default(false)
  imageKey            String?
  tags                String[]            @default([])
  active              Boolean             @default(true)
  publishedAt         DateTime?
  archivedAt          DateTime?
  deletionRequestedAt DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  versions            ProductVersion[]
  editions            Edition[]
  prices              Price[]
  policies            LicensePolicy[]
  artifacts           ProductArtifact[]
  artifactUploadSessions ArtifactUploadSession[]
  licenses            License[]
  subscriptions       Subscription[]
  trials              TrialGrant[]
  offers              DiscountOffer[]
  cleanupJobs         StorageCleanupJob[]
  commissioningRuns   CommissioningRun[]

  @@index([deletionRequestedAt])
}

model Edition {
  id                String          @id @default(cuid())
  productId         String
  slug              String
  name              String
  description       String?
  features          Json            @default("[]")
  maxUsers          Int             @default(1)
  maxDevicesPerUser Int             @default(1)
  updatePolicy      UpdatePolicy    @default(LIFETIME)
  active            Boolean         @default(true)
  sortOrder         Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchasePlans     PurchasePlan[]
  licenses          License[]
  subscriptions     Subscription[]
  trials            TrialGrant[]
  offers            DiscountOffer[]

  @@unique([productId, slug])
  @@index([productId, active, sortOrder])
}

model PurchasePlan {
  id                  String           @id @default(cuid())
  editionId           String
  type                PurchasePlanType
  currency            String           @default("PHP")
  amountMinor         Int?
  listAmountMinor     Int?
  annualDiscountBps   Int?
  renewalBehavior     RenewalBehavior  @default(NONE)
  active              Boolean          @default(true)
  monthlySourcePlanId String?
  legacyPriceId       String?          @unique
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  edition             Edition          @relation(fields: [editionId], references: [id], onDelete: Cascade)
  monthlySource       PurchasePlan?    @relation("AnnualMonthlySource", fields: [monthlySourcePlanId], references: [id], onDelete: Cascade)
  annualPlans         PurchasePlan[]   @relation("AnnualMonthlySource")
  legacyPrice         Price?           @relation(fields: [legacyPriceId], references: [id], onDelete: SetNull)
  licenses            License[]
  subscriptions       Subscription[]
  offers              DiscountOffer[]

  @@unique([editionId, type])
  @@index([editionId, active])
}

model ProductVersion {
  id              String            @id @default(cuid())
  productId       String
  version         String
  releaseNotes    String?
  changelog       String?
  channel         ReleaseChannel    @default(STABLE)
  lifecycle       ReleaseLifecycle  @default(DRAFT)
  deprecatedAt    DateTime?
  active          Boolean           @default(true)
  operatingSystem String
  architecture    String
  isLatest        Boolean           @default(false)
  publishedAt     DateTime?
  releasedAt      DateTime          @default(now())
  product         Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  artifacts       ProductArtifact[]
  artifactUploadSessions ArtifactUploadSession[]
  supplyChainEvidence SupplyChainEvidence?
  approvals       ReleaseApproval[]
  backupEvidence  String?
  complianceEvidence String?
  migrationEvidence String?
  commissioningRuns CommissioningRun[]

  @@unique([productId, version])
  @@index([productId, lifecycle])
}

model Price {
  id              String       @id @default(cuid())
  productId       String
  licensePolicyId String
  name            String
  amountMinor     Int
  currency        String       @default("PHP")
  billingType     BillingType
  intervalUnit    IntervalUnit?
  intervalCount   Int?
  active          Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  product         Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  licensePolicy   LicensePolicy @relation(fields: [licensePolicyId], references: [id], onDelete: Restrict)
  legacyPlan      PurchasePlan?
  orderItems      OrderItem[]
  subscriptions   Subscription[]
}

model LicensePolicy {
  id                String   @id @default(cuid())
  productId         String
  name              String
  maxSeats          Int
  maxDevicesPerSeat Int
  validityDays      Int?
  createdAt         DateTime @default(now())
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  prices            Price[]
  orderItems        OrderItem[]

  @@index([productId])
}

model ProductArtifact {
  id                    String         @id @default(cuid())
  productId             String
  versionId             String
  platform              String
  architecture          String
  objectKey             String?
  storageBucket         String?
  sha256                String
  sizeBytes             BigInt
  originalFilename      String
  contentType           String
  malwareStatus         String         @default("PENDING")
  malwareScannedAt      DateTime?
  malwareScanDetail     Json?
  active                Boolean        @default(true)
  artifactUrl           String?
  artifactUrlSource     String?
  artifactUrlUpdatedAt  DateTime?
  createdAt             DateTime       @default(now())
  product               Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  version               ProductVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  uploadSessions        ArtifactUploadSession[]
  commissioningRuns     CommissioningRun[]

  @@unique([productId, versionId, platform, architecture])
  @@index([productId, versionId, active])
}

model ArtifactUploadSession {
  id               String              @id @default(cuid())
  productId        String
  versionId        String
  artifactId       String?
  createdById      String
  objectKey        String
  originalFilename String
  contentType      String
  expectedSizeBytes BigInt
  expectedSha256   String?
