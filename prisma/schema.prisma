  account           CustomerAccount    @relation(fields: [accountId], references: [id], onDelete: Restrict)
  product           Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  price             Price              @relation(fields: [priceId], references: [id], onDelete: Restrict)
  purchasePlan      PurchasePlan?      @relation(fields: [purchasePlanId], references: [id], onDelete: SetNull)
  edition           Edition?           @relation(fields: [editionId], references: [id], onDelete: SetNull)
  offerRedemptions  OfferRedemption[]
  licenses          License[]

  @@index([accountId, status])
  @@index([productId, status])
  @@index([purchasePlanId, status])
}

model License {
  id                  String        @id @default(cuid())
  publicId            String        @unique
  keyHash              String        @unique
  keyLastFour          String
  keyCiphertext        String
  accountId            String
  orderId              String?
  orderItemId          String?
  productId            String
  editionId            String?
  purchasePlanId       String?
  subscriptionId       String?
  status               LicenseStatus @default(ACTIVE)
  issuedAt             DateTime      @default(now())
  expiresAt            DateTime?
  maxSeats             Int
  maxDevicesPerSeat    Int
  account              CustomerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  order                Order?        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItem            OrderItem?    @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
