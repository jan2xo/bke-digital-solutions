  @@index([status, startsAt, endsAt])
  @@index([productId, editionId, purchasePlanId])
  @@index([customerAccountId, status])
}

model OfferRedemption {
  id               String                  @id @default(cuid())
  offerId          String
  customerAccountId String
  orderId          String?
  subscriptionId   String?
  status           OfferRedemptionStatus   @default(RESERVED)
  reservedAt       DateTime                @default(now())
  appliedAt        DateTime?
  releasedAt       DateTime?
  refundedAt       DateTime?
  discountBps      Int
  catalogAmountMinor Int
  discountAmountMinor Int
  finalAmountMinor Int
