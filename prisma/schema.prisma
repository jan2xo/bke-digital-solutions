  @@unique([accountId, productId, trialStartsAt])
  @@index([accountId, productId, trialStartsAt])
  @@index([trialEndsAt])
}

model Subscription {
  id                String             @id @default(cuid())
  publicId          String             @unique
  accountId         String
  productId         String
  priceId           String
  purchasePlanId    String?
  editionId         String?
