model Order {
  id               String      @id @default(cuid())
  number           String      @unique
  accountId        String
  status           OrderStatus @default(PENDING)
  currency         String      @default("PHP")
  subtotalMinor    Int
  discountMinor    Int         @default(0)
  taxMinor         Int         @default(0)
  totalMinor       Int
