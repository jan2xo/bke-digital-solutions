NODE_ENV=production
DEPLOYMENT_ENV=production
DEPLOYMENT_ID=bke-production
APP_URL=https://jl-bke.com
INTERNAL_APP_URL=http://app:3000
PUBLIC_WEBHOOK_ORIGIN=
LOCAL_PRODUCTION_SIMULATION=false
APP_DOMAIN=jl-bke.com
ACME_EMAIL=security@jl-bke.com
TRUSTED_ORIGINS=
TRUST_PROXY_HOPS=1
DATABASE_URL=postgresql://bke_application:replace-database-password@postgres:5432/bke
DIRECT_DATABASE_URL=
POSTGRES_DB=bke
POSTGRES_USER=bke_application
POSTGRES_PASSWORD=replace-database-password
SESSION_SECRET=replace-with-at-least-48-random-characters-for-production
MFA_ENCRYPTION_KEY=replace-with-a-separate-48-character-production-secret
LICENSE_PEPPER=replace-with-a-different-48-character-production-secret
CRON_SECRET=replace-with-an-independent-48-character-production-secret
REDIS_URL=redis://valkey:6379
REDIS_KEY_PREFIX=bke-production
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
S3_ENDPOINT=https://YOUR_PRIVATE_S3_COMPATIBLE_ENDPOINT
S3_REGION=auto
S3_BUCKET=bke-production-private
S3_ACCESS_KEY_ID=replace-storage-access-key
S3_SECRET_ACCESS_KEY=replace-storage-secret-key
S3_FORCE_PATH_STYLE=false
MAX_ARTIFACT_BYTES=262144000
MINIO_ROOT_USER=replace-minio-root-user
MINIO_ROOT_PASSWORD=replace-minio-root-password
PAYMENT_PROVIDER=paymongo
PAYMONGO_SECRET_KEY=replace-after-phase-5.2-certification
PAYMONGO_WEBHOOK_SECRET=replace-after-phase-5.2-certification
PAYMONGO_LIVEMODE=false
EMAIL_PROVIDER=resend
RESEND_API_KEY=replace-after-phase-5.3-certification
EMAIL_FROM=BKE Digital Solutions <noreply@jl-bke.com>
SUPPORT_EMAIL=support@jl-bke.com
LOG_LEVEL=info
ALLOW_DESTRUCTIVE_ADMIN=false
MONITORING_DSN=
BACKUP_BUCKET=
BACKUP_RETENTION_DAYS=30
