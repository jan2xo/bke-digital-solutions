NODE_ENV=production
DEPLOYMENT_ENV=production
DEPLOYMENT_ID=bke-production
APP_URL=https://jl-bke.com
INTERNAL_APP_URL=http://app:3000
PUBLIC_WEBHOOK_ORIGIN=
LOCAL_PRODUCTION_SIMULATION=false
APP_DOMAIN=jl-bke.com
ACME_EMAIL=security@jl-bke.com
TRUSTED_ORIGINS=
TRUST_PROXY_HOPS=1
DATABASE_URL=postgresql://bke_application:replace-database-password@postgres:5432/bke
DIRECT_DATABASE_URL=
POSTGRES_DB=bke
POSTGRES_USER=bke_application
POSTGRES_PASSWORD=replace-database-password
SESSION_SECRET=replace-with-at-least-48-random-characters-for-production
MFA_ENCRYPTION_KEY=replace-with-a-separate-48-character-production-secret
LICENSE_PEPPER=replace-with-a-different-48-character-production-secret
LICENSE_SIGNING_KEY_ID=production-ed25519-v1
LICENSE_SIGNING_PRIVATE_KEY=replace-with-base64-encoded-ed25519-private-key
LICENSE_SIGNING_PUBLIC_KEY=replace-with-base64-encoded-ed25519-public-key
SUPPLY_CHAIN_SIGNING_KEY_ID=production-supply-chain-ed25519-v1
SUPPLY_CHAIN_SIGNING_PUBLIC_KEY=replace-with-base64-encoded-supply-chain-public-key
SUPPLY_CHAIN_TRUSTED_KEYS=
CRON_SECRET=replace-with-an-independent-48-character-production-secret
REDIS_URL=redis://valkey:6379
REDIS_KEY_PREFIX=bke-production
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Primary private object storage. In the self-hosted production Compose deployment,
# MinIO is reachable only on the private Docker network; it has no host ports.
S3_ENDPOINT=http://minio:9000
S3_REGION=auto
S3_BUCKET=bke-production-private
S3_ACCESS_KEY_ID=replace-storage-access-key
S3_SECRET_ACCESS_KEY=replace-storage-secret-key
S3_FORCE_PATH_STYLE=true
MAX_ARTIFACT_BYTES=262144000
MINIO_ROOT_USER=replace-minio-root-user
MINIO_ROOT_PASSWORD=replace-minio-root-password
PAYMENT_PROVIDER=paymongo
PAYMONGO_SECRET_KEY=replace-after-phase-5.2-certification
PAYMONGO_WEBHOOK_SECRET=replace-after-phase-5.2-certification
PAYMONGO_LIVEMODE=false
PROVIDER_CONFIG_SOURCE=environment
PROVIDER_CONFIG_ALLOW_ENV_FALLBACK=false
PROVIDER_CREDENTIALS_ENCRYPTION_KEY=replace-with-a-separate-48-character-provider-credentials-key
PROVIDER_CREDENTIALS_KEY_VERSION=1
PROVIDER_CREDENTIALS_PREVIOUS_KEYS=
EMAIL_PROVIDER=resend
RESEND_API_KEY=replace-after-phase-5.3-certification
EMAIL_FROM=BKE Digital Solutions <noreply@jl-bke.com>
SUPPORT_EMAIL=support@jl-bke.com
BUSINESS_ADDRESS=replace-with-reviewed-business-address
LOG_LEVEL=info
ALLOW_DESTRUCTIVE_ADMIN=false
ALLOW_BREAK_GLASS=false
ADMIN_OWNER_RECOVERY_KEY=replace-with-a-separate-random-owner-recovery-secret
ADMIN_OWNER_RECOVERY_KEY_VERSION=1
MALWARE_SCANNER_PROVIDER=replace-with-approved-production-scanner
MALWARE_SCANNER_VERSION=replace-with-scanner-version
MONITORING_DSN=
BACKUP_ENABLED=true
BACKUP_S3_ENDPOINT=https://replace-with-offsite-s3-endpoint.example
BACKUP_S3_REGION=auto
BACKUP_BUCKET=replace-with-bke-production-backups
BACKUP_S3_ACCESS_KEY_ID=replace-with-dedicated-backup-access-key
BACKUP_S3_SECRET_ACCESS_KEY=replace-with-dedicated-backup-secret-key
BACKUP_S3_FORCE_PATH_STYLE=false
BACKUP_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
BACKUP_ENCRYPTION_KEY_VERSION=1
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=12
BACKUP_WORKER_POLL_SECONDS=10
BACKUP_RESTORE_DATABASE_URL=
BACKUP_RESTORE_S3_BUCKET=
BACKUP_RESTORE_ACK=
BACKUP_OFFSITE_ACK=SEPARATE_FAILURE_DOMAIN
