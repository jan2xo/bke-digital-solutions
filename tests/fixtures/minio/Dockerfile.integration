# syntax=docker/dockerfile:1.7
# Use the same immutable release images as the production storage topology.
# Never consume unverified responses from GitHub Releases as test executables.
FROM minio/minio:RELEASE.2025-04-22T22-12-26Z@sha256:a1ea29fa28355559ef137d71fc570e508a214ec84ff8083e39bc5428980b015e AS minio-release
FROM minio/mc:RELEASE.2025-04-16T18-13-26Z@sha256:aead63c77f9db9107f1696fb08ecb0faeda23729cde94b0f663edf4fe09728e3 AS mc-release
FROM node:22.18-alpine@sha256:1b2479dd35a99687d6638f5976fd235e26c5b37e8122f786fcd5fe231d63de5b

COPY --from=minio-release /usr/bin/minio /usr/local/bin/minio
COPY --from=mc-release /usr/bin/mc /usr/local/bin/mc

RUN chmod 0755 /usr/local/bin/minio /usr/local/bin/mc
