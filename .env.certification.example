# Copy to the ignored .env.certification and replace every generated placeholder.
NODE_ENV=production
DEPLOYMENT_ENV=staging
DEPLOYMENT_ID=bke-local-certification
LOCAL_PRODUCTION_SIMULATION=true
APP_URL=https://jl-bke.com
INTERNAL_APP_URL=http://app:3000
PUBLIC_WEBHOOK_ORIGIN=https://jl-bke.com
APP_DOMAIN=jl-bke.com
ACME_EMAIL=security@jl-bke.com
TRUSTED_ORIGINS=https://jl-bke.com
TRUST_PROXY_HOPS=1
DATABASE_URL=postgresql://bke_certification:GENERATE_DATABASE_PASSWORD@postgres:5432/bke_certification
DIRECT_DATABASE_URL=
POSTGRES_DB=bke_certification
POSTGRES_USER=bke_certification
POSTGRES_PASSWORD=GENERATE_DATABASE_PASSWORD
SESSION_SECRET=GENERATE_INDEPENDENT_48_CHARACTER_SECRET
MFA_ENCRYPTION_KEY=GENERATE_INDEPENDENT_48_CHARACTER_SECRET
LICENSE_PEPPER=GENERATE_INDEPENDENT_48_CHARACTER_SECRET
LICENSE_SIGNING_KEY_ID=certification-ed25519-v1
LICENSE_SIGNING_PRIVATE_KEY=BASE64_OR_PEM_PRIVATE_KEY_OUTSIDE_GIT
LICENSE_SIGNING_PUBLIC_KEY=PEM_SUBJECT_PUBLIC_KEY
SUPPLY_CHAIN_SIGNING_KEY_ID=certification-supply-chain-ed25519-v1
SUPPLY_CHAIN_SIGNING_PUBLIC_KEY=PEM_SUBJECT_PUBLIC_KEY
SUPPLY_CHAIN_TRUSTED_KEYS=
ALLOW_BREAK_GLASS=false
MALWARE_SCANNER_PROVIDER=
MALWARE_SCANNER_VERSION=
MALWARE_SCANNER_HOST=
MALWARE_SCANNER_PORT=3310
MALWARE_SCANNER_TIMEOUT_MS=30000
MALWARE_SCANNER_MAX_BYTES=262144000
PROVIDER_CREDENTIALS_ENCRYPTION_KEY=GENERATE_INDEPENDENT_48_CHARACTER_SECRET
PROVIDER_CREDENTIALS_KEY_VERSION=1
PROVIDER_CREDENTIALS_PREVIOUS_KEYS=
PROVIDER_CONFIG_SOURCE=environment
PROVIDER_CONFIG_ALLOW_ENV_FALLBACK=false
CRON_SECRET=GENERATE_INDEPENDENT_48_CHARACTER_SECRET
REDIS_URL=redis://valkey:6379
REDIS_KEY_PREFIX=bke-local-certification
S3_ENDPOINT=http://minio:9000
S3_REGION=auto
S3_BUCKET=bke-local-certification-private
S3_ACCESS_KEY_ID=GENERATE_LOCAL_STORAGE_ACCESS_KEY
S3_SECRET_ACCESS_KEY=GENERATE_LOCAL_STORAGE_SECRET
S3_FORCE_PATH_STYLE=true
MINIO_ROOT_USER=GENERATE_LOCAL_MINIO_USER
MINIO_ROOT_PASSWORD=GENERATE_LOCAL_MINIO_PASSWORD
PAYMENT_PROVIDER=paymongo
PAYMONGO_SECRET_KEY=sk_test_REPLACE_LOCALLY
PAYMONGO_WEBHOOK_SECRET=REPLACE_LOCALLY
PAYMONGO_LIVEMODE=false
EMAIL_PROVIDER=resend
RESEND_API_KEY=REPLACE_LOCALLY
RESEND_SANDBOX_TO=OWNER_CONTROLLED_RECIPIENT
EMAIL_FROM=BKE Digital Solutions <noreply@jl-bke.com>
SUPPORT_EMAIL=support@jl-bke.com
LOG_LEVEL=info
ALLOW_DESTRUCTIVE_ADMIN=false
ADMIN_BOOTSTRAP_ACK=I_UNDERSTAND_THIS_CREATES_A_PRIVILEGED_ACCOUNT
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
